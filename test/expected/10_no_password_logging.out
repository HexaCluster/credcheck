LOAD 'credcheck';
SET log_statement = 'all';
SET lc_messages = 'C';
SET credcheck.password_min_length = 8;
SET credcheck.password_min_special = 0;
SET credcheck.password_min_digit = 0;
SET credcheck.password_min_upper = 0;
SET credcheck.password_min_lower = 0;
SET credcheck.password_contain_username = false;
-- Enabled by default
SHOW credcheck.no_password_logging;
 credcheck.no_password_logging 
-------------------------------
 on
(1 row)

SET client_min_messages TO LOG;
CREATE ROLE alice LOGIN PASSWORD 'Sup3rStr0ng!';
LOG:  statement: CREATE ROLE alice LOGIN PASSWORD '............';
ALTER ROLE alice ENCRYPTED PASSWORD 'An0therGoodOne#';
LOG:  statement: ALTER ROLE alice ENCRYPTED PASSWORD '...............';
-- Normal string literal with a doubled (embedded) quote.
CREATE ROLE bob LOGIN PASSWORD 'pa''ss W0rdX1';
LOG:  statement: CREATE ROLE bob LOGIN PASSWORD '.............';
-- Escape-string constant with a backslash escape.
CREATE ROLE dave LOGIN PASSWORD E'pa\ss W0rdX2';
LOG:  statement: CREATE ROLE dave LOGIN PASSWORD E'............';
-- Rejected password (too short) -> ERROR + "STATEMENT:" line.
ALTER ROLE alice PASSWORD 'Zq3xK';
LOG:  statement: ALTER ROLE alice PASSWORD '.....';
ERROR:  password length should match the configured credcheck.password_min_length (8)
-- Ordinary data mentioning "password", and a comment containing the word
SELECT 'my password is hunter2' AS note;
LOG:  statement: SELECT 'my password is hunter2' AS note;
          note          
------------------------
 my password is hunter2
(1 row)

/* set the password here */ CREATE ROLE carol LOGIN PASSWORD 'Comm3ntPwd!';
LOG:  statement: /* set the password here */ CREATE ROLE carol LOGIN PASSWORD '...........';
-- Issue #88: dollar-quoted password value.
CREATE ROLE erin LOGIN PASSWORD $mask_me$D0llarPwd!x$mask_me$;
LOG:  statement: CREATE ROLE erin LOGIN PASSWORD $mask_me$...........$mask_me$;
-- Issue #88: password inside a DO block, dollar-quoted or single-quoted.
DO $$ BEGIN CREATE ROLE frank LOGIN PASSWORD 'D0blockPwd!'; END $$;
LOG:  statement: DO $$ BEGIN CREATE ROLE frank LOGIN PASSWORD '...........'; END $$;
DO 'BEGIN CREATE ROLE gina LOGIN PASSWORD ''D0quotedPwd!''; END';
LOG:  statement: DO 'BEGIN CREATE ROLE gina LOGIN PASSWORD ''............''; END';
-- Issue #88: arguments of pg_check_password(), positional and named.
SELECT pg_check_password('erin', 'Ch3ckedPwd!');
LOG:  statement: SELECT pg_check_password('....', '...........');
 pg_check_password 
-------------------
 t
(1 row)

SELECT pg_check_password(username => 'erin', password => 'Ch3ckedPwd!');
LOG:  statement: SELECT pg_check_password(username => '....', password => '...........');
 pg_check_password 
-------------------
 t
(1 row)

-- Data mentioning "password" in a dollar-quoted string is left alone.
SELECT $$the password is not here$$ AS note;
LOG:  statement: SELECT $$the password is not here$$ AS note;
           note           
--------------------------
 the password is not here
(1 row)

-- A positional parameter is not a dollar quote.
PREPARE p(text) AS SELECT $1 AS v, $$password '$$ AS w;
LOG:  statement: PREPARE p(text) AS SELECT $1 AS v, $$password '$$ AS w;
EXECUTE p('keep me');
LOG:  statement: EXECUTE p('keep me');
DETAIL:  prepare: PREPARE p(text) AS SELECT $1 AS v, $$password '$$ AS w;
    v    |     w      
---------+------------
 keep me | password '
(1 row)

DEALLOCATE p;
LOG:  statement: DEALLOCATE p;
-- Normal behavior when no_password_logging is disabled
SET credcheck.no_password_logging = off;
LOG:  statement: SET credcheck.no_password_logging = off;
ALTER ROLE alice PASSWORD 'Zq3xK';
LOG:  statement: ALTER ROLE alice PASSWORD 'Zq3xK';
ERROR:  password length should match the configured credcheck.password_min_length (8)
DROP ROLE alice;
LOG:  statement: DROP ROLE alice;
DROP ROLE bob;
LOG:  statement: DROP ROLE bob;
DROP ROLE dave;
LOG:  statement: DROP ROLE dave;
DROP ROLE carol;
LOG:  statement: DROP ROLE carol;
DROP ROLE erin;
LOG:  statement: DROP ROLE erin;
DROP ROLE frank;
LOG:  statement: DROP ROLE frank;
DROP ROLE gina;
LOG:  statement: DROP ROLE gina;
